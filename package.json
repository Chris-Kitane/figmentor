{
  "name": "figmantor",
  "version": "1.0.0",
  "description": "Your Figma Plugin",
  "main": "code.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:ui": "vite build && powershell -Command \"Remove-Item -Force ui.html -ErrorAction SilentlyContinue; Rename-Item index.html ui.html\"",
    "build:all": "npm run build && npm run build:ui",
    "dev:plugin": "tsc -p tsconfig.json --watch",
    "dev:ui": "vite build --watch --config vite.config.ts",
    "dev": "npm-run-all --parallel dev:plugin dev:ui",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "author": "",
  "license": "",
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@figma/eslint-plugin-figma-plugins": "*",
    "@figma/plugin-typings": "^1.126.0",
    "@preact/preset-vite": "^2.10.5",
    "eslint": "^9.39.4",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.1",
    "vite": "^8.0.14",
    "vite-plugin-singlefile": "^2.3.3"
  },
  "dependencies": {
    "@preact/signals": "^2.9.1",
    "preact": "^10.29.2"
  }
}
